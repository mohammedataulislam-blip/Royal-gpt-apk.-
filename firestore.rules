rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isValidUserProfile(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             data.email is string && data.email.size() <= 120 &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
             data.emailVerified is bool &&
             data.authProvider in ['google', 'email_pending'] &&
             data.darkThemeEnabled is bool &&
             data.notificationsEnabled is bool &&
             data.saveHistoryEnabled is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidConversation(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
             data.category in ['CHAT', 'IMAGE', 'VOICE', 'WRITING', 'CODING', 'TRANSLATION', 'SUMMARIZATION', 'LEARNING', 'VISION'] &&
             data.lastMessagePreview is string && data.lastMessagePreview.size() <= 240 &&
             data.messageCount is int && data.messageCount >= 0 && data.messageCount <= 100000 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidChatMessage(data, userId, conversationId) {
      return data.userId is string && data.userId == userId &&
             data.conversationId is string && data.conversationId == conversationId &&
             data.role in ['USER', 'SYSTEM_NOTICE'] &&
             data.content is string && data.content.size() >= 1 && data.content.size() <= 4000 &&
             (!('attachmentLabel' in data) || (data.attachmentLabel is string && data.attachmentLabel.size() >= 1 && data.attachmentLabel.size() <= 200)) &&
             isValidTimestamp(data.createdAt);
    }

    match /users/{userId} {
      // PII (email) is strictly restricted to the owning user; no list scraping permitted
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'email', 'emailVerified',
                         'authProvider', 'darkThemeEnabled', 'notificationsEnabled',
                         'saveHistoryEnabled', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'email', 'photoUrl', 'emailVerified',
                         'authProvider', 'darkThemeEnabled', 'notificationsEnabled',
                         'saveHistoryEnabled', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserProfile(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'photoUrl', 'emailVerified',
                         'darkThemeEnabled', 'notificationsEnabled',
                         'saveHistoryEnabled', 'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(userId);

      match /conversations/{conversationId} {
        allow get: if isOwner(userId) && isValidId(conversationId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(conversationId) &&
                         incoming().keys().hasAll([
                           'userId', 'title', 'category', 'lastMessagePreview',
                           'messageCount', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'title', 'category', 'lastMessagePreview',
                           'messageCount', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidConversation(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(conversationId) &&
                         isValidConversation(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'title', 'category', 'lastMessagePreview',
                           'messageCount', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(conversationId);

        match /messages/{messageId} {
          allow get: if isOwner(userId) && isValidId(conversationId) && isValidId(messageId);
          allow list: if isOwner(userId) && isValidId(conversationId);

          allow create: if isOwner(userId) &&
                           isValidId(conversationId) &&
                           isValidId(messageId) &&
                           exists(/databases/$(database)/documents/users/$(userId)/conversations/$(conversationId)) &&
                           incoming().keys().hasAll([
                             'userId', 'conversationId', 'role', 'content', 'createdAt'
                           ]) &&
                           incoming().keys().hasOnly([
                             'userId', 'conversationId', 'role', 'content', 'attachmentLabel', 'createdAt'
                           ]) &&
                           isValidChatMessage(incoming(), userId, conversationId);

          allow update: if false;
          allow delete: if isOwner(userId) && isValidId(conversationId) && isValidId(messageId);
        }
      }
    }
  }
}
